local equippedArmor = {}

local function updateHealth()

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local maxHealth = 100

	for name in pairs(equippedArmor) do
		maxHealth += armorHealth[name] or 0
	end

	hum.MaxHealth = maxHealth
	hum.Health = maxHealth
end

local function equipArmor(name)

	local char = player.Character
	if not char then return end

	if name == "Elytra" then
		return
	end

	local old = char:FindFirstChild(name)
	if old then
		old:Destroy()
	end

	local part = Instance.new("Part")
	part.Name = name
	part.Color = Color3.fromRGB(50,220,220)
	part.Material = Enum.Material.Metal
	part.CanCollide = false
	part.Massless = true

	local target

	if name == "Diamond Helmet" then
		part.Size = Vector3.new(2.3,1,2.3)
		target = char:FindFirstChild("Head")

	elseif name == "Diamond Chestplate" then
		part.Size = Vector3.new(2.5,2.5,1.4)
		target = char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")

	elseif name == "Diamond Leggings" then
		part.Size = Vector3.new(2.3,2.3,1.2)
		target = char:FindFirstChild("LowerTorso")
			or char:FindFirstChild("Torso")

	elseif name == "Diamond Boots" then
		part.Size = Vector3.new(1.1,1.2,1.3)
		target = char:FindFirstChild("LeftFoot")
			or char:FindFirstChild("Left Leg")
	end

	if target then

		part.CFrame = target.CFrame

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = target
		weld.Parent = part

		part.Parent = char

		equippedArmor[name] = true

		updateHealth()
	end
end

