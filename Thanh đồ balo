local hotbarItems = {}

local function clearHotbar()

	for i = 1,9 do
		hotbarItems[i] = nil
		hotSlots[i].Text = tostring(i)
		hotSlots[i].BackgroundColor3 =
			Color3.fromRGB(70,70,70)
	end

	selectedBlock = nil
	placing = false
	placeButton.Visible = false
end

local function findHotbar(name)

	for i = 1,9 do
		if hotbarItems[i] == name then
			return i
		end
	end

	return nil
end

local function findEmptySlot()

	for i = 1,9 do
		if not hotbarItems[i] then
			return i
		end
	end

	return nil
end

local function removeFromHotbar(name)

	for i = 1,9 do

		if hotbarItems[i] == name then

			hotbarItems[i] = nil
			hotSlots[i].Text = tostring(i)
			hotSlots[i].BackgroundColor3 =
				Color3.fromRGB(70,70,70)

		end
	end

	if selectedBlock == name then
		selectedBlock = nil
		placing = false
		placeButton.Visible = false
	end
end

