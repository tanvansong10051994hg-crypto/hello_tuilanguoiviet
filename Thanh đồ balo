-- ĐẶT BLOCK
--==================================================

local function placeBlock(name)

	if not placing or not name then return end

	local char = player.Character
	local camera = workspace.CurrentCamera

	if not char or not camera then return end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		char,
		myBlocks
	}

	local result = workspace:Raycast(
		camera.CFrame.Position,
		camera.CFrame.LookVector * 30,
		params
	)

	local pos

	if result then
		pos = result.Position + result.Normal
	else
		pos = camera.CFrame.Position +
			camera.CFrame.LookVector * 10
	end

	pos = Vector3.new(
		math.floor(pos.X/2+.5)*2,
		math.floor(pos.Y/2+.5)*2,
		math.floor(pos.Z/2+.5)*2
	)

	local block = Instance.new("Part")

	block.Name = name
	block.Size = Vector3.new(2,2,2)
	block.Position = pos
	block.Anchored = true
	block.CanCollide = true
	block.Material = Enum.Material.SmoothPlastic
	block.Color = blockColors[name]
	block:SetAttribute("CreativeOwner", player.UserId)

	if name == "Glass" then
		block.Transparency = .45
	end

	block.Parent = myBlocks
end

--==================================================
-- PHÁ BLOCK
--==================================================

local function breakBlocks()

	while breaking and placing do

		local camera = workspace.CurrentCamera

		if not camera then break end

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {
			player.Character
		}

		local result = workspace:Raycast(
			camera.CFrame.Position,
			camera.CFrame.LookVector * 30,
			params
		)

		if result then

			local part = result.Instance

			if part:IsDescendantOf(myBlocks)
			and part:GetAttribute("CreativeOwner")
				== player.UserId then

				part:Destroy()
			end
		end

		task.wait(.15)
	end
end

placeButton.Activated:Connect(function()
	placeBlock(selectedBlock)
end)

placeButton.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		breaking = true

		task.spawn(breakBlocks)
	end
end)

placeButton.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		breaking = false
	end
end)

--==================================================
-- CẬP NHẬT HOTBAR
--==================================================

local function putOnHotbar(name)

	if not inventory[name] then
		return
	end

	-- Nếu đã có thì bỏ khỏi thanh đồ
	local existing = findHotbar(name)

	if existing then
		hotbarItems[existing] = nil
		hotSlots[existing].Text = tostring(existing)
		hotSlots[existing].BackgroundColor3 =
			Color3.fromRGB(70,70,70)

		if selectedBlock == name then
			selectedBlock = nil
			placing = false
			placeButton.Visible = false
		end

		return
	end

	local slot = findEmptySlot()

	if not slot then
		return
	end

	hotbarItems[slot] = name
	hotSlots[slot].Text = name
	hotSlots[slot].TextSize = 10

	hotSlots[slot].BackgroundColor3 =
		Color3.fromRGB(80,80,80)
end

--==================================================
-- BẤM Ô HOTBAR
--==================================================

for i = 1,9 do

	hotSlots[i].Activated:Connect(function()

		local name = hotbarItems[i]

		if not name then
			return
		end

		if blockColors[name] then

			if selectedBlock == name then

				-- Ấn lại = tắt đặt
				selectedBlock = nil
				placing = false
				placeButton.Visible = false

				hotSlots[i].BackgroundColor3 =
					Color3.fromRGB(70,70,70)

			else

				selectedBlock = name
				placing = true
				placeButton.Visible = true

				for n = 1,9 do
					hotSlots[n].BackgroundColor3 =
						Color3.fromRGB(70,70,70)
				end

				hotSlots[i].BackgroundColor3 =
					Color3.fromRGB(50,150,60)
			end

		elseif name == "Elytra" then

			toggleElytra()

		elseif armorHealth[name] then

			equipArmor(name)
		end
	end)
end

