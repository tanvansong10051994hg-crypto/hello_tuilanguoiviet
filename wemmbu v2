-- LOGIC KÉO RÊ GUI (DRAGGABLE)
local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
dragStart = input.Position
startPos = mainFrame.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then dragging = false end
end)
end
end)

mainFrame.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
end
end)

UserInputService.InputChanged:Connect(function(input)
if input == dragInput and dragging then
local delta = input.Position - dragStart
mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
end)

toggleBtn.MouseButton1Click:Connect(function()
mainFrame.Visible = not mainFrame.Visible
end)

-- LOGIC BRING MISSILE CHUYÊN DỤNG CHO FTAP
local function bringMissilesTo(targetCFrame)
local destination = targetCFrame + Vector3.new(0, 1000, 0)

for _, obj in ipairs(workspace:GetDescendants()) do  
	local nameLower = obj.Name:lower()  
	-- FTAP đặt tên là Missile hoặc Missle (viết sai tả ở bản cũ)  
	if nameLower:find("missile") or nameLower:find("missle") or nameLower:find("rocket") or nameLower:find("nuke") then  
		if obj:IsA("Model") then  
			obj:PivotTo(destination)  
			for _, part in ipairs(obj:GetDescendants()) do  
				if part:IsA("BasePart") then  
					part.AssemblyLinearVelocity = Vector3.zero  
					part.AssemblyAngularVelocity = Vector3.zero  
				end  
			end  
		elseif obj:IsA("BasePart") then  
			obj.CFrame = destination  
			obj.AssemblyLinearVelocity = Vector3.zero  
			obj.AssemblyAngularVelocity = Vector3.zero  
		end  
	end  
end

end

btnTarget.MouseButton1Click:Connect(function()
local text = nameBox.Text:lower()
if text == "" then return end

local targetPlayer = nil  
for _, plr in ipairs(Players:GetPlayers()) do  
	if plr.Name:lower():find(text) or plr.DisplayName:lower():find(text) then  
		targetPlayer = plr  
		break  
	end  
end  
  
if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then  
	bringMissilesTo(targetPlayer.Character.HumanoidRootPart.CFrame)  
end

end)

btnSelf.MouseButton1Click:Connect(function()
if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
bringMissilesTo(LocalPlayer.Character.HumanoidRootPart.CFrame)
end
end)
