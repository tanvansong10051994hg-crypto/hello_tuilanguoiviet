-- HOTBAR
--==================================================

local function findSlot(name)

	for i = 1,9 do
		if hotbarItems[i] == name then
			return i
		end
	end

	return nil
end

local function emptySlot()

	for i = 1,9 do
		if not hotbarItems[i] then
			return i
		end
	end

	return nil
end

local function putOnHotbar(name)

	local oldSlot = findSlot(name)

	-- Ấn lại = bỏ khỏi thanh đồ
	if oldSlot then

		hotbarItems[oldSlot] = nil
		hotSlots[oldSlot].Text = tostring(oldSlot)
		hotSlots[oldSlot].BackgroundColor3 =
			Color3.fromRGB(70,70,70)

		if selected == name then
			selected = nil
			placing = false
			placeButton.Visible = false
		end

		return
	end

	local slot = emptySlot()

	if not slot then
		return
	end

	hotbarItems[slot] = name
	hotSlots[slot].Text = name
	hotSlots[slot].TextSize = 9
end

--==================================================
-- BẤM HOTBAR
--==================================================

for i = 1,9 do

	hotSlots[i].Activated:Connect(function()

		local name = hotbarItems[i]

		if not name then
			return
		end

		if blocks[name] then

			if selected == name then

				selected = nil
				placing = false
				placeButton.Visible = false

				hotSlots[i].BackgroundColor3 =
					Color3.fromRGB(70,70,70)

			else

				selectItem(name)

			end

		elseif name == "Flint & Steel" then

			selectItem(name)

		elseif armorHealth[name] then

			equipArmor(name)

		elseif name == "Elytra" then

			toggleElytra()
		end
	end)
end

