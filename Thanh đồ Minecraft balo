local function createBlock(name,pos)

	local block = Instance.new("Part")

	block.Name = name
	block.Size = Vector3.new(2,2,2)
	block.Position = pos
	block.Anchored = true
	block.CanCollide = true
	block.Color = blocks[name]
	block.Material = Enum.Material.SmoothPlastic

	block:SetAttribute("CreativeOwner",player.UserId)

	if name == "Glass" then
		block.Transparency = .45
	end

	if name == "Water" then
		block.Transparency = .35
		block.CanCollide = false
		block.Material = Enum.Material.Glass
	end

	if name == "Lava" then
		block.Transparency = .15
		block.Material = Enum.Material.Neon
	end

	block.Parent = myBlocks

	return block
end

--==================================================
-- ĐẶT BLOCK
--==================================================

local function placeBlock()

	if not placing or not selected then
		return
	end

	if selected == "Flint & Steel"
	or selected == "Diamond Helmet"
	or selected == "Diamond Chestplate"
	or selected == "Diamond Leggings"
	or selected == "Diamond Boots"
	or selected == "Elytra" then
		return
	end

	local result = getRay()
	local camera = workspace.CurrentCamera

	if not camera then return end

	local pos

	if result then
		pos = result.Position + result.Normal * 1.01
	else
		pos = camera.CFrame.Position +
			camera.CFrame.LookVector * 10
	end

	pos = Vector3.new(
		math.floor(pos.X/2+.5)*2,
		math.floor(pos.Y/2+.5)*2,
		math.floor(pos.Z/2+.5)*2
	)

	local newBlock = createBlock(selected,pos)

	--================================================
	-- WATER CHẢY
	--================================================

	if selected == "Water" then

		task.spawn(function()

			local current = newBlock

			for step = 1,6 do

				if not current.Parent then
					break
				end

				task.wait(.4)

				local directions = {
					Vector3.new(2,0,0),
					Vector3.new(-2,0,0),
					Vector3.new(0,0,2),
					Vector3.new(0,0,-2)
				}

				for _,dir in ipairs(directions) do

					local p = current.Position + dir

					local check = workspace:Raycast(
						p + Vector3.new(0,3,0),
						Vector3.new(0,-6,0)
					)

					if not check then

						local exists = false

						for _,b in ipairs(myBlocks:GetChildren()) do
							if b.Name == "Water"
							and (b.Position-p).Magnitude < .5 then
								exists = true
								break
							end
						end

						if not exists then
							createBlock("Water",p)
						end
					end
				end

				current = current
			end
		end)
	end

	--================================================
	-- LAVA CHẢY CHẬM
	--================================================

	if selected == "Lava" then

		task.spawn(function()

			local current = newBlock

			for step = 1,5 do

				if not current.Parent then
					break
				end

				task.wait(1)

				local directions = {
					Vector3.new(2,0,0),
					Vector3.new(-2,0,0),
					Vector3.new(0,0,2),
					Vector3.new(0,0,-2)
				}

				for _,dir in ipairs(directions) do

					local p = current.Position + dir

					local exists = false

					for _,b in ipairs(myBlocks:GetChildren()) do
						if b.Name == "Lava"
						and (b.Position-p).Magnitude < .5 then
							exists = true
							break
						end
					end

					if not exists then
						createBlock("Lava",p)
					end
				end
			end
		end)
	end
end

