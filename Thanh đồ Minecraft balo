local function useFlintSteel()

	if selected ~= "Flint & Steel" then
		return
	end

	local result = getRay()

	if not result then
		return
	end

	local part = result.Instance

	if part.Name == "TNT"
	and part:IsDescendantOf(myBlocks) then

		igniteTNT(part)
	end
end

