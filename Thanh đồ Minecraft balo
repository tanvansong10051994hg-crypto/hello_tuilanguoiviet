local function stopFly()

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if velocity then
		velocity:Destroy()
		velocity = nil
	end

	if gyro then
		gyro:Destroy()
		gyro = nil
	end
end

local function startFly()

	if flying then return end

	local char = player.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root or not hum then return end

	flying = true

	velocity = Instance.new("BodyVelocity")
	velocity.MaxForce = Vector3.new(1000000,1000000,1000000)
	velocity.Parent = root

	gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(1000000,1000000,1000000)
	gyro.P = 30000
	gyro.Parent = root

	flyConnection = RunService.RenderStepped:Connect(function()

		if not flying then return end

		local camera = workspace.CurrentCamera

		local v = hum.MoveDirection * 65

		if up then
			v += Vector3.new(0,55,0)
		end

		if down then
			v += Vector3.new(0,-55,0)
		end

		velocity.Velocity = v

		gyro.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + camera.CFrame.LookVector
		)
	end)
end

function toggleElytra()

	local char = player.Character
	if not char then return end

	local old = char:FindFirstChild("Elytra")

	if old then

		old:Destroy()

		stopFly()

		upButton.Visible = false
		downButton.Visible = false

		return
	end

	local torso =
		char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")

	if not torso then return end

	local wings = Instance.new("Part")

	wings.Name = "Elytra"
	wings.Size = Vector3.new(4,3,.35)
	wings.Color = Color3.fromRGB(70,70,70)
	wings.Material = Enum.Material.Metal
	wings.CanCollide = false
	wings.Massless = true
	wings.CFrame = torso.CFrame * CFrame.new(0,0,.8)

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = wings
	weld.Part1 = torso
	weld.Parent = wings

	wings.Parent = char

	upButton.Visible = true
	downButton.Visible = true

	startFly()
end

