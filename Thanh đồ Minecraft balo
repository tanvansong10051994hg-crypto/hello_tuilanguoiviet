local function igniteTNT(tnt)

	if tnt:GetAttribute("Lit") then
		return
	end

	tnt:SetAttribute("Lit",true)

	local fire = Instance.new("Fire")
	fire.Size = 5
	fire.Parent = tnt

	local light = Instance.new("PointLight")
	light.Brightness = 3
	light.Range = 12
	light.Parent = tnt

	task.wait(3)

	if not tnt.Parent then
		return
	end

	local position = tnt.Position

	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = 8
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace

	-- Chỉ xóa TNT/block do mình tạo
	for _,part in ipairs(myBlocks:GetChildren()) do

		if part:IsA("BasePart")
		and (part.Position-position).Magnitude <= 8 then

			part:Destroy()
		end
	end
end

