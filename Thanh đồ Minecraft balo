local function deleteMyBlock()

	local result = getRay()

	if not result then
		return
	end

	local part = result.Instance

	if part:IsDescendantOf(myBlocks)
	and part:GetAttribute("CreativeOwner") == player.UserId then

		part:Destroy()
	end
end

